NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sporealert
OPENWEATHER_API_KEY=replace_me
OPENWEATHER_BASE_URL=https://api.openweathermap.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=SporeAlert/1.0 (contact@example.com)
TWILIO_ACCOUNT_SID=replace_me
# TWILIO_SID is accepted as an alias for TWILIO_ACCOUNT_SID.
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=+15555550123
# TWILIO_PHONE is accepted as an alias for TWILIO_FROM_NUMBER.
ALERT_CRON=0 */6 * * *
CRON_SECRET=replace_with_a_long_random_value
WEATHER_CACHE_TTL_SECONDS=1800
MAX_SEARCH_RADIUS_KM=50
